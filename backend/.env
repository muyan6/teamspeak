# 首次启动前请填写 ADMIN_PASSWORD；初始化后密码会保存到 SQLite。
PORT=4321
ADMIN_PASSWORD=

# 生产环境请使用固定的随机长字符串，避免服务重启后登录令牌失效。
JWT_SECRET=

# TS3 ServerQuery 连接信息。首次启动后也可以在后台“服务器配置”中修改。
TS3_HOST=
TS3_QUERY_PORT=10011
TS3_SERVER_PORT=9987
TS3_SERVER_ID=0
TS3_QUERY_USERNAME=serveradmin
TS3_QUERY_PASSWORD=

# 网站展示给玩家的连接地址；留空时默认使用 TS3_HOST 与 9987 端口。
TS3_PUBLIC_HOST=
TS3_PUBLIC_PORT=9987

# 站点基础信息与本地存储。
SITE_TITLE=Voice
SITE_SERVER_NAME=TeamSpeak 3
DB_PATH=data/ts3monitor.db
COLLECT_INTERVAL_MS=30000
SAMPLE_INTERVAL_MS=300000
